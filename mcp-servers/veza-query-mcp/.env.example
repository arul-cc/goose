# Copy to a location OUTSIDE this repo (e.g. ~/.veza.env), fill in, chmod 600.
#   cp .env.example ~/.veza.env && chmod 600 ~/.veza.env && source ~/.veza.env
#
# Never commit a filled-in copy. The API key inherits its creator's permissions —
# treat it as a credential to the whole tenant.

export VEZA_URL="https://<tenant>.vezacloud.com"
export VEZA_API_KEY="<personal-api-key>"

# Optional — transport settings (stdio is the default and is preferred).
# export VEZA_MCP_TRANSPORT="stdio"        # stdio | streamable-http | sse
# export VEZA_MCP_HOST="127.0.0.1"         # do not widen without an auth proxy
# export VEZA_MCP_PORT="8000"
# export VEZA_MCP_PATH="/mcp"
