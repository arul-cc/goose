# Copy to deploy/goose.env (gitignored) and fill in.
#
# Compose reads the tagging vars from a ROOT .env file, and passes this file to
# the container as env_file. Two different files on purpose: the root .env is
# build-time metadata, this one is runtime secrets that must not reach the image.

# --- required ---------------------------------------------------------------
# goose serve will not start without this. CowGooseService sends the same value
# as the x-secret-key header.
GOOSE_SERVER_SECRET_KEY=

# --- provider ---------------------------------------------------------------
# Whatever your config.yaml's provider needs, e.g.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# §6: this fork sets metadata.user_id per tenant; disable Anthropic prompt
# caching when tenants must not share a cache prefix.
# ANTHROPIC_DISABLE_CACHE=1

# --- ports ------------------------------------------------------------------
# GOOSE_HOST_PORT=3000
